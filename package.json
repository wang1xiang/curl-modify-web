{
  "name": "curl-modify-web",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "pnpm -F client dev",
    "build": "pnpm -F client build",
    "preview": "pnpm -F client preview",
    "server": "node server/server.js",
    "lint": "pnpm -F client lint",
    "lint:fix": "pnpm -F client lint:fix",
    "format": "pnpm -F client format",
    "prepare": "husky install"
  },
  "devDependencies": {
    "husky": "^9.0.0",
    "lint-staged": "^15.2.0"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,css}": [
      "prettier --write"
    ]
  }
}
